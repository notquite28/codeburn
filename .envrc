# Load the nix flake devShell for codeburn (build + run inside nix).
# Works with or without nix-direnv installed:
#   - if nix-direnv is present, `use flake` caches the evaluation;
#   - otherwise we fall back to `nix develop --print-dev-env` (re-evals on change).
watch_file flake.nix flake.lock
if has use_flake; then
  use flake
else
  eval "$(nix develop --print-dev-env .# 2>/dev/null)"
fi
